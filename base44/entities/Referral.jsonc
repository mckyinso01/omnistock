{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "User ID of the referrer"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the referrer"
    },
    "referred_email": {
      "type": "string",
      "description": "Email of the referred user"
    },
    "referred_user_id": {
      "type": "string",
      "description": "User ID of the referred user (set after registration)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "installed",
        "basic_subscribed"
      ],
      "default": "pending",
      "description": "Status of the referral"
    },
    "bonus_awarded": {
      "type": "boolean",
      "default": false,
      "description": "Whether the install bonus (7-day Pro trial) has been awarded"
    },
    "loyalty_counted": {
      "type": "boolean",
      "default": false,
      "description": "Whether this referral has been counted toward the 10-subscription loyalty bonus"
    }
  },
  "required": [
    "referrer_id"
  ]
}