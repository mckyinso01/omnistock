{
  "name": "StockAdjustment",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "adjustment_type": {
      "type": "string",
      "enum": [
        "add",
        "subtract",
        "set"
      ],
      "description": "Type of adjustment"
    },
    "quantity_before": {
      "type": "number"
    },
    "quantity_change": {
      "type": "number"
    },
    "quantity_after": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "enum": [
        "restock",
        "damaged",
        "expired",
        "lost",
        "theft",
        "correction",
        "returned",
        "transfer_in",
        "transfer_out",
        "other"
      ],
      "default": "restock"
    },
    "notes": {
      "type": "string"
    },
    "adjusted_by": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch where the adjustment occurred"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    }
  },
  "required": [
    "product_id",
    "adjustment_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}