{
  "name": "StockAlert",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Linked product ID"
    },
    "product_name": {
      "type": "string",
      "description": "Product name for quick reference"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "low_stock",
        "out_of_stock",
        "expiring_soon",
        "expired",
        "anomaly_sales_drop",
        "anomaly_pilferage",
        "inter_branch_request"
      ],
      "description": "Type of alert"
    },
    "current_quantity": {
      "type": "number",
      "description": "Current stock quantity at time of alert"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold that triggered the alert"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Expiry date if applicable"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "dismissed",
        "escalated"
      ],
      "default": "active"
    },
    "severity": {
      "type": "string",
      "enum": [
        "branch",
        "regional",
        "hq"
      ],
      "default": "branch",
      "description": "Routing severity \u2014 determines who gets notified"
    },
    "notes": {
      "type": "string",
      "description": "Alert notes"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this alert belongs to"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    }
  },
  "required": [
    "product_id",
    "alert_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}