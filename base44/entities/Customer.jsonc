{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Customer full name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address": {
      "type": "string",
      "description": "Address"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "Birthday for loyalty perks"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0,
      "description": "Accumulated loyalty points (unified across all branches)"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total amount spent across all branches"
    },
    "visit_count": {
      "type": "number",
      "default": 0,
      "description": "Number of transactions across all branches"
    },
    "branch_visits": {
      "type": "array",
      "description": "Per-branch visit breakdown for cross-branch segmentation",
      "items": {
        "type": "object",
        "properties": {
          "branch_id": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "visit_count": {
            "type": "number"
          },
          "total_spent": {
            "type": "number"
          },
          "last_visit_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Notes about customer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}