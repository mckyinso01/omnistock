{
  "name": "SyncSetting",
  "type": "object",
  "properties": {
    "spreadsheet_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet ID or full URL"
    },
    "sheet_tab_name": {
      "type": "string",
      "description": "Sheet tab name to append per-sale rows to",
      "default": "Transactions"
    },
    "daily_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Run the per-sale sync automatically at 11 PM Manila time each night"
    },
    "weekly_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Run the per-sale sync automatically every Monday at 11 PM Manila time"
    },
    "monthly_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Run the per-sale sync automatically on the 1st of each month at 11 PM Manila time"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of the most recent completed sync run, used to dedupe so old sales are never re-appended"
    }
  },
  "required": [
    "spreadsheet_id"
  ]
}