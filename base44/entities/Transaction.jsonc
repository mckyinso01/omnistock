{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "transaction_number": {
      "type": "string",
      "description": "Unique transaction reference number"
    },
    "type": {
      "type": "string",
      "enum": [
        "sale",
        "refund",
        "adjustment",
        "restock"
      ],
      "default": "sale",
      "description": "Type of transaction"
    },
    "items": {
      "type": "array",
      "description": "List of items in the transaction",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "discount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal before discounts"
    },
    "discount_amount": {
      "type": "number",
      "description": "Total discount applied",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "description": "Tax amount",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "description": "Final total amount"
    },
    "amount_tendered": {
      "type": "number",
      "description": "Amount given by customer"
    },
    "change_amount": {
      "type": "number",
      "description": "Change returned to customer"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "gcash",
        "maya",
        "card",
        "bank_transfer",
        "split"
      ],
      "default": "cash"
    },
    "payment_details": {
      "type": "string",
      "description": "Additional payment reference or notes"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name (optional)"
    },
    "notes": {
      "type": "string",
      "description": "Transaction notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "voided",
        "pending"
      ],
      "default": "completed"
    },
    "cashier_name": {
      "type": "string",
      "description": "Name of the cashier"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch where the transaction occurred"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    }
  },
  "required": [
    "total_amount",
    "payment_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}