{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Purchase Order number"
    },
    "supplier_id": {
      "type": "string",
      "description": "Linked supplier ID"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "items": {
      "type": "array",
      "description": "List of items ordered",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity_ordered": {
            "type": "number"
          },
          "quantity_received": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "partial",
        "received",
        "cancelled",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "draft"
    },
    "expected_date": {
      "type": "string",
      "format": "date"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this PO belongs to"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation ID"
    },
    "approval_request_id": {
      "type": "string",
      "description": "Linked ApprovalRequest ID if routed for HQ approval"
    },
    "distributed_branches": {
      "type": "array",
      "description": "For bulk POs distributed across multiple branches",
      "items": {
        "type": "object",
        "properties": {
          "branch_id": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "supplier_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.branch_id": {
            "$in": "{{user.data.managed_branch_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}