{
  "openapi": "3.1.0",
  "info": {
    "title": "StockMate POS & Inventory API",
    "version": "1.0.0",
    "description": "Enterprise Point-of-Sale & Inventory Management API"
  },
  "servers": [
    {
      "url": "http://localhost:5173",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "List Inventory Products",
        "responses": {
          "200": { "description": "Returns array of stock items" }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "summary": "Process POS Transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items", "total"],
                "properties": {
                  "items": { "type": "array" },
                  "total": { "type": "number" },
                  "paymentMethod": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Transaction completed & receipt generated" }
        }
      }
    }
  }
}
